{"nodes": [{"id": "readme_strays", "label": "strays (herdr plugin)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1-13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_herdr", "label": "herdr (terminal multiplexer host)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:5-6", "source_url": "https://herdr.dev", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_live_worktree_following", "label": "Live worktree following via filesystem events", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:28-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driven by filesystem events rather than a polling timer so an idle repository costs nothing and a busy one coalesces into a single refresh instead of a hundred."}, {"id": "readme_project_discovery", "label": "Project discovery from herdr pane working directories", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projects are derived from the working directories of herdr's open panes rather than a configured list; several panes in one repository collapse into one entry so the same repo is never shown twice."}, {"id": "readme_workspace_scope", "label": "Workspace scope toggle", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:33-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens scoped to the current workspace to avoid overwhelming the pane, with `w` widening to every repository herdr has open, each as its own foldable subtree."}, {"id": "readme_diff_viewer", "label": "Inline diff viewer", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:37-40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Puts the diff where the user is already looking so reading a change costs no context switch; a position indicator orients the reader inside a long diff."}, {"id": "readme_diff_scope_head", "label": "Diff scope: working tree vs HEAD", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staged, unstaged and untracked changes are unified into one tree compared against HEAD, so the user sees everything that strayed regardless of index state."}, {"id": "readme_claude_handoff", "label": "Claude agent hand-off", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:41-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prompt is typed into the target repository's agent input with the file path attached but deliberately not submitted, so the user reviews the text and presses Enter themselves."}, {"id": "readme_editor_launch_safety", "label": "Safe editor launch ($VISUAL then $EDITOR)", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:46-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The file path is passed as its own argv entry behind a `--` separator and never reaches a shell, so a hostile filename from someone else's branch stays a filename instead of becoming a command."}, {"id": "readme_read_only_git", "label": "Read-only git invariant", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:51-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every git call is a query: no add, commit, checkout or stash, and nothing is written to refs/, so the plugin can never damage the user's worktree or history."}, {"id": "readme_status_markers", "label": "Glyph status markers (M A D ? R S)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meaning is carried by the glyph rather than by colour so mono terminals and colour-blind readers lose no information."}, {"id": "readme_show_all_view", "label": "Show-all-tracked-files view", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unchanged files join the list dimmed so a change stands out against the surrounding repository rather than floating without context."}, {"id": "readme_gitignore_honoured", "label": "Honours .gitignore", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignored build output must never reach the tree, otherwise generated files drown the real changes."}, {"id": "readme_large_directory_folding", "label": "Large-directory auto-folding threshold (25 strays)", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A directory holding 25 or more strays starts folded with its count shown, so a generated-output tree cannot bury real work."}, {"id": "readme_submodule_handling", "label": "Submodule handling", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submodules are shown as `S` but never offered to an editor because a gitlink is a directory, not a file."}, {"id": "readme_branch_display", "label": "Branch display with detached-HEAD fallback", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A detached HEAD shows its short commit rather than the useless word `HEAD`, so the user can still identify where the repo sits."}, {"id": "readme_keybindings", "label": "Keybinding reference", "file_type": "document", "source_file": "README.md", "source_location": "README.md:74-93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_plugin_install", "label": "Plugin install and key binding configuration", "file_type": "document", "source_file": "README.md", "source_location": "README.md:95-132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Install builds from source (requires a Rust toolchain); `plugin link` from a checkout skips the build step, so `cargo build --release` must be run first."}, {"id": "readme_plugin_action_strays_open", "label": "aleslanger.strays.open plugin action", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:104-118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pressing the bound key again focuses the existing pane instead of opening a second one, and pressing it while focused dismisses the pane \u2014 a single-instance toggle."}, {"id": "readme_requirements", "label": "Runtime requirements (herdr 0.7.0+, git, Rust toolchain)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:120-121", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_strays", "target": "readme_herdr", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:5", "weight": 1.0}, {"source": "readme_strays", "target": "readme_live_worktree_following", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 