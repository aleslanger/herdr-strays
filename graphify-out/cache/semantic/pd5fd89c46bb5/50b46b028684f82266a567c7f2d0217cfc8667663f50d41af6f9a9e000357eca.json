{"nodes": [{"id": "github_workflows_ci_ci", "label": "CI workflow", "file_type": "document", "source_file": ".github/workflows/ci.yml", "source_location": ".github/workflows/ci.yml:1-9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on pushes to master and on every pull request; CARGO_TERM_COLOR=always keeps cargo output readable in the Actions log."}, {"id": "github_workflows_ci_check", "label": "check job (fmt, clippy, test)", "file_type": "document", "source_file": ".github/workflows/ci.yml", "source_location": ".github/workflows/ci.yml:12-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates on cargo fmt --check, clippy with -D warnings across all targets, and cargo test."}, {"id": "github_workflows_ci_os_matrix", "label": "ubuntu/macos OS matrix", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": ".github/workflows/ci.yml:13-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The integration tests shell out to the real git binary and the plugin only claims linux and macos, so both platforms are worth running; fail-fast is disabled so one platform's failure does not hide the other's."}, {"id": "github_workflows_ci_git_identity", "label": "Give git an identity step", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": ".github/workflows/ci.yml:30-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The integration tests create commits, so a global git user.name/user.email must exist even where the test helper does not set one."}, {"id": "github_workflows_ci_audit", "label": "audit job (rustsec/audit-check)", "file_type": "document", "source_file": ".github/workflows/ci.yml", "source_location": ".github/workflows/ci.yml:46-60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "